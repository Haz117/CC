# Conexión a Supabase (ver "Nueva carpeta/Guía de conexión.pdf")
# Copia este archivo como .env.local y pon la publishable key que te pasa Luis.

# URL de la API (viene en la guía de conexión). La base es provisional: puede cambiar cuando pase a producción.
VITE_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co

# Publishable key (antes "anon key"): Panel → Project Settings → API Keys.
# NUNCA pongas aquí la secret key / service_role: se salta toda la seguridad.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: dominio interno de las cuentas. En pantalla se entra con usuario y contraseña; por dentro
# la app pregunta a Supabase Auth por usuario@<dominio>, así que cada cuenta se crea con ese correo
# en el panel (Authentication → Users → Add user). Si no se pone, es cremerias.local.
# VITE_DOMINIO_USUARIOS=cremerias.local

# Opcional: ofrece el modo demostración en el login aunque Supabase esté configurado.
# VITE_MODO_DEMO=true
